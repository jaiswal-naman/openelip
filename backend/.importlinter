[importlinter]
root_package = app
include_external_packages = True

# ARCHITECTURE 3.3: a module imports only from lower layers; siblings on one line may not import each other.
# Layers in parentheses are optional so the contract holds while a module does not exist yet.
# The composition roots (app.main, app.worker, app.cli) are outside the layers and may import anything.
[importlinter:contract:layers]
name = Module layers
type = layers
containers =
    app
layers =
    (evals)
    (chat) | (brief) | (agentnet)
    (campaigns) | (twin)
    (hiring) | (apply)
    (guardian) | (tailor)
    (match)
    (ingest) | (profile)
    (trust)
    platform

# ARCHITECTURE 3.3 rule 3: only app.platform.llm imports a model provider SDK.
# The adapters arrive in plan 01-04, so an ignored import that does not exist yet is not an error.
[importlinter:contract:model-sdks]
name = Only app.platform.llm imports a model provider SDK
type = forbidden
source_modules =
    app
forbidden_modules =
    anthropic
    openai
ignore_imports =
    app.platform.llm -> anthropic
    app.platform.llm -> openai
    app.platform.llm.** -> anthropic
    app.platform.llm.** -> openai
unmatched_ignore_imports_alerting = none

# ARCHITECTURE 5.9 item 14: only app.guardian.runtime, app.campaigns, app.twin and app.chat import langgraph.
# Written in the form of model-sdks (source app, ignored edges), not as a list of source modules: import-linter counts
# indirect chains, so app.main -> app.chat.routes -> app.chat.loop -> langgraph passes because its last edge is ignored,
# and any other way to reach langgraph (a new module, or a chain through a module not listed) fails.
# Only app.chat exists today; the other three are listed so their plans need no edit here.
[importlinter:contract:langgraph-scope]
name = Only the modules ARCHITECTURE 5.9 names import langgraph
type = forbidden
source_modules =
    app
forbidden_modules =
    langgraph
ignore_imports =
    app.chat -> langgraph
    app.chat.** -> langgraph
    app.guardian.runtime -> langgraph
    app.guardian.runtime.** -> langgraph
    app.campaigns -> langgraph
    app.campaigns.** -> langgraph
    app.twin -> langgraph
    app.twin.** -> langgraph
unmatched_ignore_imports_alerting = none

# ARCHITECTURE 5.9 item 12: nodes and loops call app.platform.llm, never a LangChain model class, and no langchain_*
# provider package is installed. langchain_core and langgraph_sdk arrive as langgraph's own dependencies and stay inert.
[importlinter:contract:langchain-out]
name = langchain_core and langgraph_sdk stay out of app
type = forbidden
source_modules =
    app
forbidden_modules =
    langchain_core
    langgraph_sdk

# NET-01: only app.agentnet imports the MCP SDK. Written like langgraph-scope (source app, ignored edges), so a chain
# such as app.main -> app.agentnet.server -> mcp stays legal while any other module importing mcp fails.
[importlinter:contract:mcp-scope]
name = Only app.agentnet imports the MCP SDK
type = forbidden
source_modules =
    app
forbidden_modules =
    mcp
ignore_imports =
    app.agentnet -> mcp
    app.agentnet -> mcp.**
    app.agentnet.** -> mcp
    app.agentnet.** -> mcp.**
unmatched_ignore_imports_alerting = none
