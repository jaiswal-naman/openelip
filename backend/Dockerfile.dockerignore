# git history, secrets, database backups and the web app out of the build.
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/node_modules
.git
.env
.env.*
.planning
backups
docs
web
scripts
.github
backend/tests
