# Copy this file to .env (git-ignored), then start everything with:   docker compose up
# Docker Compose reads .env by itself. Every line is optional: a value you leave out falls back to the default shown here.
#
# DEVELOPMENT ONLY. Every key and password below is published in this repository, so none of them is a secret. The
# application refuses to start with any of them when APP_BASE_URL is not a localhost address (backend/app/platform/config.py),
# which means a public server cannot run on these values by accident. Generate your own before you host it anywhere:
#   data key:     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   other keys:   any long random string
# Running the backend on the host instead of in Docker needs no DATABASE_URL_* lines: the defaults in config.py already
# point at 127.0.0.1:5433.

# Which optional services start. dev = Mailpit, the local mail catcher: sign-in codes arrive at http://localhost:8025.
# Add local-llm to also start Ollama, a local model server (see the model section below).
COMPOSE_PROFILES=dev

APP_ENV=development
# The address people use in the browser. It decides where links point and whether the session cookie is marked Secure.
APP_BASE_URL=http://localhost:8080

# Host ports, all bound to 127.0.0.1. Change them when a port is taken, or to run a second copy beside the first.
# APP_HTTP_PORT=8080
# APP_MAIL_PORT=8025
# APP_DB_PORT=5433

# Passwords of the two database roles the migration step creates. The superuser that owns the schema is the one in docker-compose.yml.
APP_DB_API_PASSWORD=app_api_local_only
APP_DB_WORKER_PASSWORD=app_worker_local_only

# The api and the worker must share these three values exactly: the api seals sign-in codes, the worker opens them.
APP_DATA_KEYS=b3BlbmVsaXAtZGV2ZWxvcG1lbnQtb25seS1rZXktMDA=
APP_LOOKUP_KEY=openelip-development-lookup-key
APP_LINK_KEY=openelip-development-link-key

# Outgoing mail. In development it goes to Mailpit; for real mail put your provider's URL here (smtp://user:pass@host:587).
SMTP_URL=smtp://mail:1025
MAIL_FROM=no-reply@localhost

# Language-model provider. With no usable provider every model feature answers 503 ai_disabled; the job index, search and
# sign-in still work.
#   fake               recorded answers, no network and no cost (refused when APP_ENV=production)
#   anthropic          set ANTHROPIC_API_KEY
#   openai             set OPENAI_API_KEY
#   openai_compatible  a local model server: COMPOSE_PROFILES=dev,local-llm and LLM_BASE_URL=http://llm:11434/v1
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
